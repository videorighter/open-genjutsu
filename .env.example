# scripts/configure.py generates random secrets from this template.
POSTGRES_PASSWORD=CHANGE_ME
TEMPORAL_POSTGRES_PASSWORD=CHANGE_ME
GENJUTSU_SECRET_KEY=CHANGE_ME
GENJUTSU_ADMIN_EMAIL=admin@example.com
GENJUTSU_ADMIN_PASSWORD=CHANGE_ME
HTTP_PORT=8000
# Local development only. Enable HTTPS before allowing remote access.
GENJUTSU_PUBLIC_URL=http://localhost:8000
GENJUTSU_SECURE_COOKIES=false
# For public TLS: set domain, https public URL and secure cookies; use --profile tls.
GENJUTSU_DOMAIN=localhost
# Optional Cloudflare Tunnel: compose.yaml + compose.tunnel.yaml, profile tunnel.
# OpenRouter reads video references only from a public HTTPS GENJUTSU_PUBLIC_URL,
# such as this tunnel; images and analysis travel inline without it.
# Put the token only in your private .env. Never commit or paste it in chat.
CLOUDFLARE_TUNNEL_TOKEN=
GENJUTSU_MAX_UPLOAD_MB=512
GENJUTSU_MAX_VIDEO_SECONDS=120
GENJUTSU_USER_STORAGE_MB=2048
GENJUTSU_MAX_ACTIVE_JOBS=2
GENJUTSU_MAX_PAID_STEPS=4
# OpenRouter catalog refresh interval and inline (data URL) media limit without public HTTPS.
GENJUTSU_CATALOG_TTL_SECONDS=21600
GENJUTSU_MAX_INLINE_MEDIA_MB=20
